# Variables serveur. Ne pas y placer de valeur réelle dans Git.
# Générer les secrets avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

DATABASE_URL=
# disable uniquement pour un Postgres local sans TLS. Neon et la production restent en require.
DATABASE_SSL=require

# 32 caractères minimum. Signe les cookies de session.
AUTH_SECRET=

# 32 octets en base64. Chiffre le secret TOTP administrateur.
AUTH_MFA_KEY=

# Origine publique, sans barre finale. https obligatoire quand NODE_ENV=production.
APP_URL=http://localhost:3000

# Adresses promues administrateur après clic sur le lien magique, séparées par des virgules.
ADMIN_EMAILS=

# Déjà utilisées par le formulaire de contact.
RESEND_API_KEY=
RESEND_FROM=

# Obligatoires en production pour limiter les liens magiques et les codes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe, mode test uniquement. sk_live_ et pk_live_ sont refusées
# tant que STRIPE_ALLOW_LIVE n'est pas exactement true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_FRIEND_HOST_MONTHLY=
STRIPE_PRICE_FRIEND_CARE_MONTHLY=
STRIPE_ALLOW_LIVE=
