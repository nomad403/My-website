{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "next dev --turbo",
    "lint": "next lint",
    "start": "next start",
    "capture": "node scripts/capture.mjs",
    "capture:browser": "node scripts/capture.mjs --headed",
    "security:install": "node scripts/install-strix.mjs",
    "security:check": "node scripts/strix.mjs doctor",
    "security:scan": "node scripts/strix.mjs scan",
    "security:strix": "node scripts/strix.mjs",
    "test:security": "node --test tests/contact-security.test.mjs tests/contact-durable.test.mjs tests/cloudflare-preview.test.mjs",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "build:cloudflare": "node scripts/check-preview-build.mjs && node scripts/check-cloudflare.mjs && opennextjs-cloudflare build --config wrangler.jsonc --openNextConfigPath open-next.config.ts",
    "preview:cloudflare": "node scripts/check-cloudflare.mjs --built && opennextjs-cloudflare preview --config wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare": "node scripts/check-cloudflare.mjs --built && opennextjs-cloudflare deploy --config wrangler.jsonc",
    "build:next": "next build",
    "postbuild:next": "next-sitemap",
    "publish:preview": "node scripts/publish-preview.mjs",
    "audit:preview": "node scripts/publish-preview.mjs --check",
    "publish": "node scripts/publish-preview.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "framer-motion": "^12.23.3",
    "next": "^15.5.28",
    "next-sitemap": "^4.2.3",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "^6.0.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "jsqr": "^1.4.0",
    "miniflare": "5.20261110.1-beta",
    "playwright": "^1.63.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "browserslist": "^4.29.4",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.7",
    "sucrase": "^3.35.1",
    "glob": {
      ".": "14.0.5",
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
