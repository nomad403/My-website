{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "my-website"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "my-v0-project-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [],
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "NOMAD403_ENV": "preview"
    },
    "services": [],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "nomad403-preview-opennext-cache"
      }
    ],
    "images": {
      "binding": "IMAGES"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "CONTACT_LIMITER",
          "class_name": "ContactLimiter"
        }
      ]
    }
  },
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACT_LIMITER",
        "class_name": "ContactLimiter"
      }
    ]
  },
  "exports": {
    "ContactLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
