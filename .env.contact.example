# Cloudflare Production runtime (server only):
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Cloudflare antispam: CONTACT_LIMITER Durable Object, declared in wrangler.jsonc.
# No Redis credentials are needed on Cloudflare. See docs/CONTACT-CLOUDFLARE.md.

# Legacy Vercel runtime only: durable Redis REST credentials remain supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV_REST_API_URL / KV_REST_API_TOKEN aliases are also supported.
