# Configuration serveur uniquement : copier les variables dans l'hébergeur.
# Créer un Redis Upstash durable, puis récupérer les identifiants REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Les intégrations Vercel fournissant KV_REST_API_URL / KV_REST_API_TOKEN sont aussi reconnues.

# Variables mail déjà utilisées par le site :
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
